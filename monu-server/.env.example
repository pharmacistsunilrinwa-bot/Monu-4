# ============================================================
# GENERIC PROVIDER EXTENSION EXAMPLES
# ============================================================
# Future providers can follow this naming pattern:
#
# PROVIDER_API_KEY_1=
# PROVIDER_API_KEY_2=
# PROVIDER_API_KEY_3=
#
# The MONU Credential Pool will discover numbered credentials dynamically.
# There is no architecture-level maximum number of credentials.
# ============================================================


# ============================================================
# NODE / REMOTE CONNECTION PLACEHOLDERS
# ============================================================

MONU_NODE_TOKEN=
MONU_REMOTE_NODE_TOKEN=
MONU_WEBSOCKET_URL=
MONU_WEBRTC_SIGNALING_URL=


# ============================================================
