# ============================================================
# MONU SERVER - ENVIRONMENT TEMPLATE
# ============================================================
# IMPORTANT:
# - This file contains placeholders only.
# - Never put real secrets in Git.
# - Production secrets belong in secure deployment environment variables.
# - Multiple credentials per provider are supported.
# - Number suffixes below are examples, not a hard limit.
# ============================================================

# ------------------------------------------------------------
# MONU CORE
# ------------------------------------------------------------
MONU_ENV=development
MONU_DEBUG=false
MONU_LOG_LEVEL=INFO

MONU_HOST=0.0.0.0
MONU_PORT=8000

MONU_APP_NAME=MONU Server
MONU_VERSION=0.1.0

MONU_ENABLE_MEMORY=true
MONU_ENABLE_PROVIDERS=true
MONU_ENABLE_TOOLS=true
MONU_ENABLE_AGENTS=true

MONU_CONFIG_PATH=configs


# ------------------------------------------------------------
# DATABASE / CACHE
# ------------------------------------------------------------
DATABASE_URL=
REDIS_URL=
VECTOR_DATABASE_URL=
KNOWLEDGE_DATABASE_URL=


# ------------------------------------------------------------
# MONU SECURITY
# ------------------------------------------------------------
MONU_SECRET_KEY=CHANGE_ME_WITH_SECURE_RANDOM_VALUE
MONU_OWNER_ID=OWNER_ID_PLACEHOLDER

MONU_STEP1_AUTH_ENABLED=true
MONU_STEP2_AUTH_ENABLED=true
MONU_SECURE_SESSION_TTL_MINUTES=15


# ============================================================
# GOOGLE / GEMINI CREDENTIAL POOL
# ============================================================

GEMINI_API_KEY_1=GEMINI_DUMMY_KEY_1
GEMINI_API_KEY_2=GEMINI_DUMMY_KEY_2
GEMINI_API_KEY_3=GEMINI_DUMMY_KEY_3

GOOGLE_API_KEY_1=GOOGLE_DUMMY_KEY_1
GOOGLE_API_KEY_2=GOOGLE_DUMMY_KEY_2

GOOGLE_SEARCH_API_KEY_1=GOOGLE_SEARCH_DUMMY_KEY_1
GOOGLE_SEARCH_API_KEY_2=GOOGLE_SEARCH_DUMMY_KEY_2

GOOGLE_CLOUD_API_KEY_1=GOOGLE_CLOUD_DUMMY_KEY_1
GOOGLE_CLOUD_API_KEY_2=GOOGLE_CLOUD_DUMMY_KEY_2

GOOGLE_CLOUD_PROJECT_ID=GOOGLE_CLOUD_PROJECT_PLACEHOLDER


# ============================================================
# GROQ CREDENTIAL POOL
